# PaperWrapped Configuration
# Copy this file to .env and fill in your values

# Flask secret key - used to keep sessions secure
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-string

# Database URL (default: SQLite file in project folder)
DATABASE_URL=sqlite:///paperwrapped.db

# School name (shown in the Wrapped experience)
SCHOOL_NAME=Our School
